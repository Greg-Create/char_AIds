# Copy to .env.local (git-ignored). The API runs entirely on this Mac.

# Gemini video understanding (required for real judging; without it a
# deterministic fallback judge is used).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: post the losing clip to X. Off by default; both players must consent.
ENABLE_X_POSTS=false
X_USER_ACCESS_TOKEN=
X_ACCOUNT_USERNAME=
