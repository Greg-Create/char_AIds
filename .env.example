# Browser API base. Leave empty for same-origin /api (recommended).
VITE_API_URL=

# Gemini Flash video/image understanding.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Required for durable rooms and private clip storage on Vercel.
BLOB_READ_WRITE_TOKEN=

# Durable room state/signaling (Upstash Redis REST or Vercel Marketplace Redis).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional TURN relay for reliable WebRTC across restrictive networks.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Public posting is opt-in and also requires both players' consent.
ENABLE_X_POSTS=false
X_USER_ACCESS_TOKEN=
X_ACCOUNT_USERNAME=

# Optional browser origin restriction for a separately hosted frontend.
ALLOWED_ORIGIN=
